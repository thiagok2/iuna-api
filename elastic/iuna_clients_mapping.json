{
    "iuna_clients": {
        "mappings": {
            "properties": {
                "client_id": {
                    "type": "keyword"
                },
                "client_secret_hash": {
                    "type": "keyword"
                },
                "name": {
                    "type": "text",
                    "fields": {
                        "keyword": {
                            "type": "keyword",
                            "ignore_above": 256
                        }
                    }
                },
                "role": {
                    "type": "keyword"
                },
                "active": {
                    "type": "boolean"
                },
                "created_at": {
                    "type": "date"
                }
            }
        }
    }
}
