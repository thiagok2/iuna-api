# ============================================================
# IUNA API — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env.
# ============================================================

# --- Projeto ---
PROJECT_NAME="IUNA API"
API_V1_STR="/api/v1"

# --- Autenticação (Bearer token simples) ---
# Gere com: python3 -c "import uuid; print(uuid.uuid4())"
API_SECRET_TOKEN=

# --- Elasticsearch ---
ELASTICSEARCH_HOSTS="https://seu-elastic:9200"
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=
# Sufixo opcional para nomes de índices (ex: "_dev", "_test"). Vazio em produção.
ES_INDEX_SUFFIX=

# --- LLM — escolha um provedor e preencha a chave correspondente ---
# Valores aceitos: gemini | claude | ollama
ACTIVE_LLM_PROVIDER="gemini"

# Google Gemini (provedor padrão)
GEMINI_API_KEY=
# Alternativas texto: gemini-2.0-flash | gemini-2.5-flash | gemini-2.5-pro
GEMINI_TEXT_MODEL="gemini-2.0-flash"
# Alternativas embed: gemini-embedding-001 | text-embedding-004
GEMINI_EMBED_MODEL="gemini-embedding-001"

# Anthropic Claude (alternativo)
CLAUDE_API_KEY=
# Alternativas: claude-haiku-4-5 | claude-sonnet-4-6 | claude-opus-4-8
CLAUDE_MODEL="claude-haiku-4-5"

# Ollama — LLM local, sem internet
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# --- Rasa NLU ---
RASA_API_URL="http://rasa:5005"

# --- Chat ---
# Tempo de vida da sessão de chat em horas
CHAT_SESSION_TTL_HOURS=24
# Máximo de mensagens mantidas no histórico
CHAT_HISTORY_MAX_MESSAGES=10

# --- Batch Processing ---
# Número de tarefas concorrentes no processamento batch
BATCH_DEFAULT_CONCURRENCY=3
